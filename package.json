{
    "name": "wp-boilerplate",
    "version": "1.0.0",
    "description": "ACF Pro flexible-content WordPress boilerplate theme with a Vite build and Docker dev environment.",
    "scripts": {
        "start": "docker compose up -d",
        "stop": "docker compose down",
        "restart": "docker compose restart",
        "clean": "docker compose down -v --remove-orphans",
        "logs": "docker compose logs",
        "shell": "docker compose exec wordpress bash",
        "build": "vite build",
        "dev": "vite",
        "prod": "vite build --mode production",
        "lint:php": "cd themes/boilerplate && composer lint",
        "fix:php": "cd themes/boilerplate && composer lint:fix",
        "format:php-all": "prettier --write \"**/*.php\"",
        "format:php": "prettier --write",
        "format:all": "prettier --write src/**/*.{js,scss,php}",
        "format:scss": "prettier --write \"**/*.scss\"",
        "stylelint": "stylelint",
        "lint:scss": "stylelint \"**/*.scss\"",
        "lint:fix": "stylelint \"**/*.scss\" --fix",
        "eslint": "eslint",
        "eslint:js": "eslint \"src/**/*.js\"",
        "eslint:fix": "eslint \"src/**/*.js\" --fix",
        "db:backup": "node bin/db/backup.js",
        "db:restore": "node bin/db/restore.js",
        "db:import": "node bin/db/import.js",
        "wp": "docker compose exec wp-cli wp",
        "wp:seed": "docker compose exec wp-cli wp eval-file /workspace/bin/wp/seed-content.php --path=/var/www/html",
        "wp:update": "docker compose exec wp-cli wp core update && docker compose exec wp-cli wp plugin update --all",
        "wp:install-plugin": "docker compose exec wp-cli wp plugin install",
        "wp:search-replace": "docker compose exec wp-cli wp search-replace",
        "wp:flush-cache": "docker compose exec wp-cli wp cache flush",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/unknownsock/wp-boilerplate.git"
    },
    "author": "Unknownsock",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/unknownsock/wp-boilerplate/issues"
    },
    "homepage": "https://github.com/unknownsock/wp-boilerplate#readme",
    "dependencies": {
        "cssnano": "^5.1.12",
        "dotenv": "^17.2.3",
        "jcf": "^1.2.3",
        "jquery": "^3.6.3",
        "jquery-validation": "^1.19.5",
        "leaflet": "^1.9.4",
        "ll": "^1.2.0",
        "lodash": "^4.17.21",
        "lodash.throttle": "^4.1.1",
        "pace-js": "^1.2.4",
        "postcss-import": "^14.1.0",
        "postcss-preset-env": "^7.7.2",
        "postcss-sort-media-queries": "^5.2.0",
        "sass-fluid": "^2.0.0",
        "swiper": "^14.1.0"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.25.0",
        "autoprefixer": "^10.4.14",
        "browserslist": "^4.21.5",
        "husky": "^9.1.7",
        "modernizr": "^3.12.0",
        "postcss-custom-properties": "^13.1.5",
        "postcss-loader": "^7.2.4",
        "prettier": "^3.9.6",
        "sass": "^1.101.0",
        "vite": "^8.1.5"
    }
}
