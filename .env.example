# Host ports - change these if another project's stack is already using them
# (e.g. running two boilerplate-based projects locally at once).
WP_PORT=8000
PHPMYADMIN_PORT=8080

# Database - MYSQL_* and WORDPRESS_DB_* in docker-compose.yml both read from
# these, so they stay in sync automatically.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASS=wordpress
DB_ROOT_PASSWORD=change-me
