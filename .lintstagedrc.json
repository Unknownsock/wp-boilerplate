{
    "src/**/*.js": [
        "prettier --write",
        "eslint --fix",
        "git add"
    ],
    "src/**/*.{css,scss}": [
        "prettier --write",
        "stylelint --fix",
        "git add"
    ],
    "themes/**/*.php": [
        "npm run fix:php",
        "npm run format:php",
        "git add"
    ]
}
